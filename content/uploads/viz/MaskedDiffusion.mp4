/**
 * MaskedDiffusion — 掩码扩散并行去噪过程（教学向）
 *
 * 设计：light paper bg (#F7F8FA), dark ink, formula highlight, caption strip
 * 比例：1280×720 / 30fps / 360帧
 */

import React, { useMemo } from "react";
import {
  AbsoluteFill,
  interpolate,
  spring,
  useCurrentFrame,
  useVideoConfig,
} from "remotion";

export const DEFAULT_PROPS = {
  text: "床前明月光疑是地上霜",
  steps: 5,
} as const;

export interface MaskedDiffusionProps {
  text?: string;
  steps?: number;
}

const C = {
  bg: "#F7F8FA",
  ink: "#1a1a2e",
  muted: "#8b8ba7",
  panelBg: "#ffffff",
  panelBorder: "#e2e4ed",
  accent: "#10b981",
  accentBg: "rgba(16,185,129,0.08)",
  mask: "#d1d5db",
  maskInk: "#9ca3af",
  flash: "#f59e0b",
  formulaBg: "#f0fdf4",
  captionBg: "#ffffff",
} as const;

const CELL_W = 56;
const CELL_H = 64;
const GAP = 8;

function fade(frame: number, start: number, end: number) {
  return interpolate(frame, [start, end], [0, 1], { extrapolateLeft: "clamp", extrapolateRight: "clamp" });
}

/* 打乱揭示顺序：中间优先，非 L→R */
function buildBatches(n: number, steps: number): number[][] {
  if (n <= 0 || steps <= 0) return [];
  const order: number[] = [];
  const mid = Math.floor(n / 2);
  const used = new Set<number>();
  const push = (i: number) => { if (i >= 0 && i < n && !used.has(i)) { used.add(i); order.push(i); } };
  push(mid); push(mid - 1); push(mid + 1);
  for (let d = 2; d < n; d++) { push(mid - d); push(mid + d); }
  for (let i = 0; i < n; i++) push(i);
  const batches: number[][] = Array.from({ length: steps }, () => []);
  order.forEach((idx, i) => { batches[Math.min(Math.floor(i * steps / order.length), steps - 1)]!.push(idx); });
  return batches;
}

const TokenCell: React.FC<{
  char: string; revealed: boolean; flashing: boolean; justRevealed: boolean; fps: number; localFrame: number;
}> = ({ char, revealed, flashing, justRevealed, fps, localFrame }) => {
  const pop = justRevealed ? spring({ frame: Math.max(0, localFrame), fps, config: { damping: 14, stiffness: 220 } }) : 1;
  const pulse = flashing ? 0.5 + 0.5 * Math.sin(localFrame * 0.5) : 1;
  return (
    <div style={{
      width: CELL_W, height: CELL_H, borderRadius: 10,
      display: "flex", alignItems: "center", justifyContent: "center",
      background: revealed ? C.accentBg : "#f3f4f6",
      border: `2px solid ${flashing ? C.flash : revealed ? C.accent : C.mask}`,
      boxShadow: flashing ? `0 0 0 3px ${C.flash}40` : "0 1px 3px rgba(0,0,0,0.06)",
      transform: `scale(${pop * (flashing && !revealed ? 0.96 + 0.04 * pulse : 1)})`,
      opacity: flashing && !revealed ? pulse : 1, flexShrink: 0,
    }}>
      <span style={{ fontSize: revealed ? 22 : 14, fontWeight: 700, fontFamily: "system-ui, -apple-system, sans-serif", color: revealed ? C.ink : C.maskInk }}>
        {revealed ? char : "?"}
      </span>
    </div>
  );
};

export const MaskedDiffusion: React.FC<MaskedDiffusionProps> = ({
  text = DEFAULT_PROPS.text,
  steps = DEFAULT_PROPS.steps,
}) => {
  const frame = useCurrentFrame();
  const { fps } = useVideoConfig();
  const chars = useMemo(() => Array.from(text), [text]);
  const n = chars.length;
  const batches = useMemo(() => buildBatches(n, steps), [n, steps]);

  const SETUP = 25;
  const PER = 20;
  const step = frame < SETUP ? -1 : Math.min(steps - 1, Math.floor((frame - SETUP) / PER));
  const local = step >= 0 ? frame - SETUP - step * PER : 0;
  const flashing = step >= 0 && local < 10;
  const committed = step >= 0 && local >= 10;

  const revealStepOf = useMemo(() => {
    const map = new Array(n).fill(steps);
    batches.forEach((b, s) => { for (const i of b) map[i] = s; });
    return map;
  }, [batches, n, steps]);

  const isRevealed = (i: number) => {
    if (step < 0) return false;
    const rs = revealStepOf[i]!;
    if (step > rs) return true;
    if (step === rs) return committed;
    return false;
  };

  const cells: React.ReactNode[] = [];
  for (let i = 0; i < n; i++) {
    const r = isRevealed(i);
    const fl = flashing && step >= 0 && revealStepOf[i] === step && !r;
    const jr = committed && step >= 0 && revealStepOf[i] === step && local < 20;
    cells.push(<TokenCell key={i} char={chars[i]!} revealed={r} flashing={fl} justRevealed={jr} fps={fps} localFrame={Math.max(0, local - 10)} />);
  }

  const shown = cells.filter((_, i) => isRevealed(i)).length;
  let caption = "";
  if (frame < SETUP) caption = "";
  else if (step < steps - 1) {
    const cur = batches[Math.max(0, step)] ?? [];
    caption = `第 ${Math.max(0, step) + 1}/${steps} 步：并行打分，揭开 ${cur.length} 个位置。`;
  } else {
    caption = `完成：${steps} 步去噪，揭示顺序 ≠ 从左到右。`;
  }

  return (
    <AbsoluteFill style={{ background: C.bg, fontFamily: "system-ui, -apple-system, sans-serif", color: C.ink }}>
      <div style={{
        position: "absolute", top: 12, left: 32, right: 32, height: 48,
        background: C.formulaBg, borderRadius: 10, border: "1px solid #d1fae5",
        display: "flex", alignItems: "center", justifyContent: "center",
        opacity: fade(frame, 5, 20),
      }}>
        <span style={{ fontSize: 15, fontWeight: 600 }}>
          ℒ = −𝔼ₓ,ₜ [ Σ_{i∈ℳₜ} log p_θ(x_i | x_{ℳₜ}, t) ]  ←  掩码扩散交叉熵
        </span>
      </div>

      <div style={{
        position: "absolute", top: 72, left: 32, right: 32,
        display: "flex", justifyContent: "center", gap: 24, opacity: fade(frame, 8, 25),
      }}>
        <div style={{ background: C.panelBg, padding: "6px 16px", borderRadius: 8, border: `1px solid ${C.panelBorder}` }}>
          <span style={{ fontSize: 14, fontWeight: 600, color: C.accent }}>去噪步 {Math.max(0, step + 1)}/{steps}</span>
        </div>
        <div style={{ background: C.panelBg, padding: "6px 16px", borderRadius: 8, border: `1px solid ${C.panelBorder}` }}>
          <span style={{ fontSize: 14, fontWeight: 600, color: C.muted }}>已揭示 {shown}/{n}</span>
        </div>
      </div>

      <div style={{
        position: "absolute", top: "50%", left: "50%", transform: "translate(-50%,-50%)",
        opacity: fade(frame, 10, 25),
      }}>
        <div style={{ display: "flex", flexWrap: "wrap", gap: GAP, justifyContent: "center", maxWidth: 760 }}>
          {cells}
        </div>
      </div>

      <div style={{
        position: "absolute", left: 32, right: 32, bottom: 12, minHeight: 56,
        padding: "12px 18px", borderRadius: 10, background: C.captionBg,
        border: `1px solid ${C.panelBorder}`,
        display: "flex", alignItems: "center", opacity: fade(frame, 10, 25),
      }}>
        <span style={{ fontSize: 14, lineHeight: 1.4, color: C.ink, fontWeight: 500 }}>
          {frame < SETUP ? "即将开始…" : caption}
        </span>
      </div>
    </AbsoluteFill>
  );
};

export default MaskedDiffusion;
