# ===== 敏感度分级（P3-04）=====
# 本项目是单用户本地优先，所有密钥默认放 .env 即可。但若你把仓库推到远端协作、
# 或想隔离「个人凭据 / 团队共享配置」，建议按敏感度分文件存放：
#
#   .env            —— 通用部署配置（端口、模型名、CORS、业务开关）；可放入团队共享仓库
#   .env.local       —— 个人高敏感凭据（飞书 / GitHub / Cloudflare Tunnel token / 各厂商 API Key）
#                       dotenv 加载顺序：.env.local > .env（.env.local 覆盖 .env 同名键）
#   .env.*.local     —— 按场景隔离（如 .env.feishu.local 仅飞书 token；.env.tunnel.local 仅 Cloudflare）
#
# .gitignore 已忽略 .env / .env.local / .env.*.local，三者均不会进 Git。
#
# 敏感度三档（仅供自查，无强制约束）：
#   L1 公开（可写进文档/示例）：SERVER_PORT、模型名、CORS_ORIGINS、业务开关默认值
#   L2 私有（必须放 .env / .env.local）：各厂商 API Key、AUTH_PASSWORD/AUTH_TOKEN、CREDENTIAL_MASTER_KEY
#   L3 高敏（强烈建议独立 .env.local 并定期轮换）：FEISHU_*、GITHUB_TOKEN、CLOUDFLARE_TUNNEL_TOKEN、
#         AGENTMAIL_API_KEY、EMAIL_SMTP_PASS、ZHIHU_COOKIE、各平台 Cookie
#
# 轮换建议：L3 凭据每 30-90 天轮换一次；CREDENTIAL_MASTER_KEY 丢失即凭据全损，离线备份。

# ===== Database =====
DATABASE_URL="file:./dev.db"

# ===== 业务行为配置（config.yaml）=====
# 与部署/密钥无关的业务参数（如 SessionStreamHub 缓冲大小、事件 TTL 等）
# 统一放到项目根目录 config.yaml，便于教学与版本管理。
# 详见 config.yaml 注释。

# ===== Server =====
SERVER_PORT=3010
# 逗号分隔；不设则默认 localhost:3000 / 127.0.0.1:3000
# CORS_ORIGINS=https://knowpilot.example.com,http://127.0.0.1:3000

# 凭据加密主密钥（AES-256-GCM 加密 Credential 表）。
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 不设：开发模式凭据明文落库（启动 warn）；生产模式拒绝启动。
# 丢失后已加密凭据无法解密；更换需重新录入凭据。
# CREDENTIAL_MASTER_KEY=

# ===== Web / Next.js =====
# Next.js rewrite 反代目标（Tunnel / 远程 dev 时可改）
# SERVER_INTERNAL_URL=http://127.0.0.1:3010
# NEXT_PUBLIC_SERVER_URL=http://127.0.0.1:3010
# About 页 profile 绝对路径（可选；默认 content/about/profile.md）
# ABOUT_PROFILE_PATH=D:/ALL IN AI/KnowPilot/content/about/profile.md
# Web dev 绑定地址；pnpm dev:remote 时使用 0.0.0.0
# WEB_HOST=0.0.0.0

# ===== Cloudflare Tunnel（可选）=====
# CLOUDFLARE_TUNNEL_TOKEN=eyJh...
# PUBLIC_URL=https://knowpilot.yourdomain.com

# ===== 可选鉴权（L5-M03）=====
# 默认 none：本地单用户无登录；password：控制台需 Bearer Token
# AUTH_MODE=none
# AUTH_MODE=password
# AUTH_PASSWORD=your-secure-password
# AUTH_TOKEN=  # 可选；不设则与 AUTH_PASSWORD 相同

# ===== Agent / LLM =====
# LLM_DEFAULT_PROVIDER=deepseek
# DEFAULT_LLM_MODEL=deepseek-v4-flash  # 全局默认模型 id（覆盖 config.yaml llm.defaultModel）
# LLM_DAILY_BUDGET=10
# REQUIRE_APPROVAL=true
# AGENT_MAX_TOOL_ROUNDS=12
# AGENT_MAX_TOOL_CALLS_PER_RUN=168
# AGENT_TOOL_CALL_TIMEOUT_MS=30000
# AGENT_TOOL_CALL_CONCURRENCY=2
# AGENT_DESTRUCTIVE_APPROVAL=false  # true 时 Agent/tRPC 删除类操作走审批（memory/post/file 等）
# APPROVAL_PENDING_TTL_MS=86400000  # pending 审批过期毫秒，默认 24h；0=关闭 TTL
# APPROVAL_PENDING_TTL_MS=86400000  # pending 审批过期（默认 24h）；0=不自动过期

# ===== Swarm =====
# SWARM_MODE=local          # local（默认，零依赖）| redis（分布式锁 + BullMQ SwarmBus，需 Redis）
# REDIS_URL=redis://127.0.0.1:6379
# AGENT_MAX_SUBAGENTS_PER_SESSION=10
# （AGENT_DESTRUCTIVE_APPROVAL / APPROVAL_PENDING_TTL_MS 见上方 Agent / LLM 段）

# ===== 通知 / 邮件 =====
# EMAIL_PROVIDER=agentmail | smtp | ntfy | none
# 可叠加：配了 NTFY_TOPIC 时，无论 EMAIL_PROVIDER 是 agentmail/smtp，都会额外推 ntfy
#
# --- AgentMail（问人 + 可发通知；Free≈3000封/月）---
# EMAIL_PROVIDER=agentmail
# EMAIL_TO=your@qq.com
# AGENTMAIL_API_KEY=
# AGENTMAIL_INBOX_ID=yourname@agentmail.to
# AGENTMAIL_ASK_TO=your@qq.com
# AGENTMAIL_WEBHOOK_SECRET=
# AGENTMAIL_WEBHOOK_URL=https://<tunnel>/api/webhooks/agentmail  # 可选；缺省由 PUBLIC_URL 派生
# 本机 webhook：https://<tunnel>/api/webhooks/agentmail（需 Cloudflare Tunnel / ngrok 暴露公网，localhost 不可达）
#
# --- ngrok 固定公网域名（推荐：免费 dev domain，永久固定，邮件 webhook 稳定）---
# 1. 注册 ngrok 免费账号 → dashboard 领一个 dev domain（如 xxx.ngrok-free.dev）
# 2. ngrok config add-authtoken <your-authtoken>
# 3. 填下面两项，pnpm dev:ngrok 启动 ngrok + dev，server 自动注册 AgentMail webhook
# NGROK_DOMAIN=xxx.ngrok-free.dev
# PUBLIC_URL=https://xxx.ngrok-free.dev
#
# --- QQ SMTP（单向邮件通知）---
# EMAIL_PROVIDER=smtp
# EMAIL_TO=2635495642@qq.com
# EMAIL_SMTP_HOST=smtp.qq.com
# EMAIL_SMTP_PORT=465
# EMAIL_SMTP_SECURE=true
# EMAIL_SMTP_USER=2635495642@qq.com
# EMAIL_SMTP_PASS=                    # QQ 邮箱「授权码」，不是登录密码
#
# --- ntfy.sh（免注册手机推送；topic 当密码，用长随机串）---
# NTFY_TOPIC=kp-your-long-random-topic
# NTFY_SERVER=https://ntfy.sh
# NTFY_PRIORITY=default
# NTFY_TOKEN=                         # 可选；自建 ntfy 才需要
#
# ASK_USER_FIRST_REMINDER_MS=600000
# ASK_USER_REPEAT_REMINDER_MS=3600000
# ASK_USER_TTL_MS=86400000

# ===== 全局代理（国内访问国外 LLM / 站点，可选）=====
# Node fetch 默认不读系统代理、不走 Clash。这里在 server 启动时一次性 setGlobalDispatcher，
# 让所有 fetch（LLM 调用 / web_search / read_article / 免费 key 同步）都走代理。
# 优先级：KP_HTTPS_PROXY > HTTPS_PROXY > HTTP_PROXY > KP_HTTP_PROXY；不设则直连。
# Clash / v2ray 本地混合端口示例：
# HTTPS_PROXY=http://127.0.0.1:7890
# # 或 KnowPilot 专用（不污染其他工具）：
# KP_HTTPS_PROXY=http://127.0.0.1:7890

# ===== AI Providers =====
# 服务端读取（改 .env 后须重启 pnpm dev:server）
# Mock LLM 服务（本地测试，省钱稳定）：pnpm start:mock-llm 启动 http://localhost:3040
#   切换：把对应厂商 baseUrl 指向 mock 服务，API Key 随便填，无需 MOCK_LLM=true
#   DEEPSEEK_BASE_URL=http://localhost:3040/v1
#   错误注入（请求 header）：x-mock-fail=429|500|401|timeout|network|overflow, x-mock-delay-ms=500, x-mock-stream-break=after-5
# DEEPSEEK_API_KEY=          # 与 VITE_DEEPSEEK_API_KEY 二选一即可
# VITE_DEEPSEEK_API_KEY=     # 兼容旧写法，仅 server 启动时 loadRootEnv 加载
# DEEPSEEK_MODEL=deepseek-v4-flash   # 默认模型；legacy deepseek-chat 会被此值覆盖
# VITE_DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=        # 配置后同步官方 :free 模型目录，并路由 *:free 模型到 OpenRouter
# OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# ===== 免费 API Key 自动同步（默认开启，server 启动即跑）=====
# FREE_KEYS_AUTO_SYNC=true   # 设 0/false 关闭
# FREE_KEYS_SYNC_INTERVAL_MS=3600000
# FREE_KEYS_PROXY=https://ghproxy.net/   # 国内拉 raw.githubusercontent.com 可选代理
# FREE_KEYS_LOCAL_FILE=content/free-keys-readme.md  # GitHub 源失败时本地 README 兜底
# FREE_KEYS_SKIP_PROBE=false # true 时跳过探活（仅解析入库）

# KIMI_API_KEY=
# VITE_KIMI_API_KEY=
# ZHIPU_API_KEY=

# ===== Search（web_search — MetaBlog smartSearch 多引擎）=====
# 引擎优先级（逗号分隔）。未设置且已配置 Tavily/SerpAPI 时，自动为 bing_crawler,tavily,serpapi,duckduckgo,...
# SEARCH_ENGINE_PRIORITY=bing_crawler,duckduckgo,baidu_qianfan,tavily,serpapi
# SEARCH_BAIDU_QIANFAN_API_KEY=
# SEARCH_METASO_API_KEY=
# SEARCH_BOCHA_API_KEY=
# SEARCH_LANGSEARCH_API_KEY=
# SEARCH_TAVILY_API_KEY=
# SEARCH_BRAVE_API_KEY=
# SEARCH_BING_API_KEY=
# SEARCH_SERPAPI_API_KEY=

# ===== 知乎数据开放平台（推荐；Inbox 收藏同步优先走此通道）=====
# 在 https://developer.zhihu.com/ 登录 → 个人中心申请 Token（Access Secret）
# 建议放 .env.local；申请后仅显示一次，丢失可删除重申
# ZHIHU_ACCESS_SECRET=
# ZHIHU_OPENAPI_BASE_URL=https://developer.zhihu.com

# ===== 网页读取（read_article — 知乎 Cookie 可选，无开放平台 key 时的回退）=====
# 浏览器 F12 → Application → Cookies → 复制 z_c0 等，格式 name=value; name2=value2
# ZHIHU_COOKIE=z_c0=...; _xsrf=...
# 微信 read_article 可选 Cookie / 冒烟 URL（integration:smoke:platform）
# WECHAT_COOKIE=...
# WECHAT_SMOKE_URL=https://mp.weixin.qq.com/s/...
# XHS_COOKIE=...   # 或 XIAOHONGSHU_COOKIE
# XHS_SMOKE_URL=https://www.xiaohongshu.com/explore/...
# DOUYIN_COOKIE=...
# DOUYIN_SMOKE_URL=https://www.douyin.com/video/...
# JUEJIN_SMOKE_URL=https://juejin.cn/post/...
# INFOQ_SMOKE_URL=https://www.infoq.cn/article/...
# CSDN_SMOKE_URL=https://blog.csdn.net/.../article/details/...
# SEGMENTFAULT_SMOKE_URL=https://segmentfault.com/a/1190000046145001
# OSCHINA_SMOKE_URL=https://www.oschina.net/news/291686/deepseek-v3
# CNBLOGS_SMOKE_URL=https://www.cnblogs.com/metaz/p/16798692.html
# JIANSHU_SMOKE_URL=https://www.jianshu.com/p/5a35a61bad8f
# 快速平台冒烟（仅 B站/掘金/CSDN）：pnpm integration:smoke:platform:quick
# medium（7 站）：pnpm integration:smoke:platform:medium
# extended（+博客园/简书，9 站）：pnpm integration:smoke:platform:extended

# Playwright 共享浏览器预热（默认开启；设为 0 可关闭以加快冷启动）
# BROWSER_WARMUP=0

# ===== OCR（Chat 非多模态发图 — PaddleOCR 本地 + OCR.space 降级）=====
# CLI 默认: tools/ocr/paddleocr_cli.py  权重: weights/ocr/paddleocr/  复制: pnpm ocr:copy
# PADDLEOCR_CLI_PATH=
# PADDLEOCR_PYTHON_PATH=d:\python-envs\baseenv\Scripts\python.exe
# PPOCR_HOME=weights/ocr/paddleocr
# OCR_SPACE_API_KEY=
# OCR_SPACE_DEFAULT_LANG=chs

# ===== 外挂视觉理解器（vision_describe 工具 — 纯文本模型外挂免费多模态看图）=====
# 默认模型选择顺序（国内优先、免费优先）：
#   1) VISION_DESCRIBE_MODEL 显式覆盖
#   2) 当前 Agent 模型若支持 vision → 复用
#   3) 智谱 ZHIPU_API_KEY → glm-4.1v-thinking-flash（免费、国内直连、无需代理）★ 国内首选
#   4) Kimi KIMI_API_KEY → kimi-k2.5（注册送免费额度、国内直连）
#   5) Gemini GEMINI_API_KEY → gemini-2.0-flash（国外，国内需代理）
#   6) OpenRouter → google/gemma-4-26b-a4b-it:free（国外，需代理）
#   7) deepseek-vl2 兜底（付费）
# 国内无 gemini/不想翻墙：去 https://open.bigmodel.cn 注册拿 ZHIPU_API_KEY（免费层），只配这一项即可。
# 显式覆盖示例：
# VISION_DESCRIBE_MODEL=glm-4.1v-thinking-flash
# VISION_DESCRIBE_MODEL=kimi-k2.5

# ===== 异步 Agent 后台任务 =====
# AGENT_ASYNC_MAX_CONCURRENT=2
# AGENT_ASYNC_MAX_PER_SESSION=2
# AGENT_ASYNC_TASK_TIMEOUT_MS=300000
# AGENT_ASYNC_QUEUED_TIMEOUT_MS=0       # 排队超时（0=不超时）
# AGENT_ASYNC_MAX_RETRIES=3

# ===== Shell（run_shell 工具 — 默认 host_restricted）=====
# SHELL_ENABLED=true
# SHELL_MODE=host_restricted
# SHELL_TIMEOUT_MS=30000
# SHELL_MAX_OUTPUT_CHARS=12000
# SHELL_BINARY=auto

# ===== Integrations（可选）=====
# GITHUB_TOKEN=
# YUQUE_SESSION=
# YUQUE_CTOKEN=
# YUQUE_TOKEN=
# FEISHU_TENANT_ACCESS_TOKEN=
