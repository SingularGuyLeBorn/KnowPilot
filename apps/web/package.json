{
  "name": "@knowpilot/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbo": "next dev",
    "dev:remote": "next dev --webpack --hostname 0.0.0.0",
    "build": "next build",
    "build:mock": "cross-env SERVER_INTERNAL_URL=http://127.0.0.1:3011 NEXT_PUBLIC_SERVER_URL=http://127.0.0.1:3011 next build",
    "analyze": "cross-env ANALYZE=true next build --webpack",
    "start": "next start",
    "start:mock": "cross-env SERVER_INTERNAL_URL=http://127.0.0.1:3011 NEXT_PUBLIC_SERVER_URL=http://127.0.0.1:3011 next start -p 3003",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:mock": "playwright test --config=playwright.config.mock.ts",
    "test:e2e:mock:prep": "pnpm run build:mock",
    "test:e2e:mock:headed": "playwright test --config=playwright.config.mock.ts --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed"
  },
